# The test harness's connection. Not the instance's.
#
# This one is an administrative connection: the harness creates a template
# database, branches it per test, and drops the branches afterwards. The daemon
# never reads it.
DATABASE_URL=postgres://postgres:altair@localhost:5432/altair

# Set this per worktree when several lanes run against one Postgres, or they
# fight over the template name.
#ALTAIR_TEST_PREFIX=altair_test

# ---------------------------------------------------------------------------
# The instance. Every one of these is required and none of them has a default.
# ---------------------------------------------------------------------------
#
# `altaird` refuses to start unless all six are set, and says which are missing
# — all of them at once, not one restart at a time. See
# crates/altaird/src/daemon/config.rs for why nothing here falls back, and in
# particular why the listen address does not: a guessed 0.0.0.0 puts a
# household's data on every interface the machine has.

# The instance's own connection to the structured store.
ALTAIR_DATABASE_URL=postgres://postgres:altair@localhost:5432/altair

# The directory the object store owns, whole. File bodies and nothing else.
ALTAIR_OBJECT_ROOT=/var/lib/altair/objects

# The token issuer this instance accepts, and only this one (DR-005: the
# instance validates, it never authenticates).
ALTAIR_ISSUER=https://auth.example.test/application/o/altair/
ALTAIR_AUDIENCE=altair

# Where that issuer publishes its signing keys. Given rather than discovered:
# startup contacts no identity provider, so a provider that is still booting
# never stops the instance from starting.
ALTAIR_JWKS_URI=https://auth.example.test/application/o/altair/jwks/

# Address and port to serve gRPC on.
ALTAIR_LISTEN=127.0.0.1:50051

# Optional. Overrides the daemon's own log filter, which is
# `warn,altaird=info,sqlx::query=off`. Raising it cannot make the instance log
# a statement or anything about a request — see
# crates/altaird/src/daemon/logging.rs.
#RUST_LOG=altaird=debug
